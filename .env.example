# 관리자 페이지(/admin) 비밀번호 — 배포 전 반드시 바꾸세요.
ADMIN_PASSWORD=change-this-please

# 서버 포트 (호스팅 업체가 자동 주입하는 경우 비워둬도 됩니다)
PORT=3000

# --- 투표 기록 저장 위치 ---
# 아래 Upstash 두 값을 넣으면 Redis 에 저장 (Render 무료 플랜 등 파일이 유지 안 되는 환경용).
# 비워두면 로컬 파일(DATA_DIR/db.json)에 저장합니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 파일 저장 시 db.json 위치 (Upstash 를 쓰면 무시됨)
DATA_DIR=./data
